{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ebrahimyoussef",
  "main": "./worker/index.js",
  "compatibility_date": "2026-08-03",
  "vars": {
    "TURNSTILE_HOSTNAME": "ebrahimyoussef.com"
  },
  "send_email": [
    {
      "name": "CONTACT_EMAIL",
      "destination_address": "me@ebrahimyoussef.com",
      "allowed_sender_addresses": ["website@ebrahimyoussef.com"]
    }
  ],
  "ratelimits": [
    {
      "name": "CONTACT_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "secrets": {
    "required": ["TURNSTILE_SECRET_KEY"]
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
