---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Hero from '../components/Hero.astro';
import SelectedWork from '../components/SelectedWork.astro';
import Services from '../components/Services.astro';
import Process from '../components/Process.astro';
import About from '../components/About.astro';
import GameFeature from '../components/GameFeature.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import GameDrawer from '../components/game/GameDrawer';
---

<BaseLayout>
  <SiteHeader />
  <main id="main">
    <Hero />
    <SelectedWork />
    <Services />
    <Process />
    <About />
    <GameFeature><GameDrawer client:idle /></GameFeature>
    <Contact />
  </main>
  <Footer />
</BaseLayout>
