---
import { products } from '../data/products';
const game = products.find((product) => product.id === 'figures-game');
---

<section id="play" class="section game-feature" aria-labelledby="game-title">
  <div class="wrap game-layout">
    <div>
      <p class="eyebrow">A little personal proof</p>
      <h2 id="game-title" class="section-heading">Try the interface, not just the portfolio.</h2>
    </div>
    <div class="game-copy">
      <p>{game?.contribution}</p>
      <slot />
    </div>
  </div>
</section>

<style>
  .game-feature { background: var(--color-text); color: var(--color-bg); }
  .game-layout { display: grid; grid-template-columns: 1fr .8fr; gap: clamp(2rem, 7vw, 7rem); align-items: end; }
  .game-layout h2 { max-width: 15ch; }
  .game-copy p { max-width: 42ch; color: var(--color-neutral-300); }
  /* the launch button only. The slot also carries the game's <dialog>, so a plain
     descendant selector here repaints every button inside the drawer, and a child
     combinator misses it because Astro wraps the island in <astro-island>. */
  .game-copy :global(.game-launch) { margin-top: 1rem; background: var(--color-bg); color: var(--color-text); }
  @media (max-width: 42rem) { .game-layout { grid-template-columns: 1fr; align-items: start; } }
</style>
