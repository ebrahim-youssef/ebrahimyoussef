---
import Arabesque from './Arabesque.astro';
import { SITE } from '../data/site';
---

<section id="contact" class="section contact" aria-labelledby="contact-title">
  <div class="wrap">
    <div class="contact-panel">
      <Arabesque variant="tile" />
      <div class="contact-inner">
        <p class="eyebrow">Let’s talk</p>
        <h2 id="contact-title">Have a real problem worth solving?</h2>
        <p>I build products that are meant to be used, not just displayed. If you have an idea, an operational pain point, or a product that needs a clearer interface, tell me what it is, who it needs to help, and where the current experience gets in the way.</p>
        <p>And if you are teaching yourself or changing careers into development, I hope something I share makes the next step clearer.</p>
        <div class="contact-actions">
          <a class="btn btn-primary" href={SITE.emailUrl}>Email me about a project</a>
          <a class="btn btn-secondary" href="#sharing">Follow the learning journey</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-panel { position: relative; overflow: hidden; padding: calc(2 * var(--leading)) clamp(var(--space-6), 4vw, calc(2 * var(--leading))); border-radius: calc(2 * var(--radius-lg)); background: var(--color-accent-2-200); }
  .contact-inner { position: relative; z-index: 1; }
  h2 { max-width: 14ch; margin: 0; text-wrap: balance; }
  .contact-inner > p:not(.eyebrow) { max-width: var(--measure); color: var(--color-neutral-700); }
  .contact-actions { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--leading); }
  :global(.contact-panel > .ey-arabesque-tile) { opacity: .035; }
  @media (max-width: 30rem) { .contact-actions, .contact-actions .btn { width: 100%; } }
</style>
