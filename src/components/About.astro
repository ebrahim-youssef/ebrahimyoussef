---
import Monogram from './Monogram.astro';
import { SITE, socialUrl } from '../data/site';
---

<section id="about" class="section" aria-labelledby="about-title">
  <div class="wrap about-layout">
    <div class="about-mark card elev-sm"><Monogram size={148} title={`${SITE.name} monogram`} /></div>
    <div>
      <p class="eyebrow">Why I do this</p>
      <h2 id="about-title" class="section-heading">I did not come to software the usual way.</h2>
      <p class="about-lead">I started in nursing. I moved into development by teaching myself: courses, freelance work, and building real projects until they worked. Figuring it out alone taught me how much harder the path is without a map, and that is why my work is split in two, building useful products and sharing what I learn along the way.</p>
      <p class="developer-note">{SITE.personalNote}</p>
      <div class="about-links">
        <a href={socialUrl('github')} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
        <a href={socialUrl('linkedin')} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
      </div>
    </div>
  </div>
</section>

<style>
  .about-layout { display: grid; grid-template-columns: minmax(10rem, .5fr) minmax(20rem, 1.2fr); gap: clamp(2.5rem, 8vw, 8rem); align-items: start; }
  .about-mark { display: grid; place-items: center; min-height: 18rem; padding: var(--leading); }
  .about-lead { max-width: var(--measure); color: var(--color-neutral-700); }
  .developer-note { max-width: var(--measure); margin-top: 2rem; padding-left: 1.2rem; border-left: 3px solid var(--color-accent-2); color: var(--color-neutral-700); }
  .about-links { display: flex; gap: 1.25rem; margin-top: 2rem; }
  .about-links a { color: var(--color-text); font-weight: 650; text-underline-offset: .35rem; }
  @media (max-width: 42rem) { .about-layout { grid-template-columns: 1fr; } .about-mark { min-height: 12rem; } }
</style>
