---
import { Image } from 'astro:assets';
import portrait from '../assets/ebrahim-portrait.jpg';
import { SITE } from '../data/site';
---

<section id="about" class="section" aria-labelledby="about-title">
  <div class="wrap about-layout">
    <figure class="about-portrait washed elev-sm">
      <Image
        src={portrait}
        alt={SITE.name}
        widths={[320, 480, 640, 960]}
        sizes="(max-width: 42rem) calc(100vw - 2.5rem), 24rem"
        loading="lazy"
      />
    </figure>
    <div>
      <p class="eyebrow">The person behind the work</p>
      <h2 id="about-title" class="section-heading">Useful software, built with care.</h2>
      <p class="about-lead">I’m Ebrahim, a front-end engineer who likes turning complicated ideas into calm, understandable products. I care about the decisions people notice—clarity, speed, accessibility—and the engineering choices that keep a product healthy after launch.</p>
      <p class="developer-note">{SITE.personalNote}</p>
      <div class="about-links">
        <a href={SITE.socials.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
        <a href={SITE.socials.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
      </div>
    </div>
  </div>
</section>

<style>
  .about-layout { display: grid; grid-template-columns: minmax(10rem, .5fr) minmax(20rem, 1.2fr); gap: clamp(2.5rem, 8vw, 8rem); align-items: start; }
  /* the system's photograph treatment: washed, and over-rounded like a card */
  .about-portrait { overflow: hidden; border-radius: calc(var(--radius-lg) * 1.15); background: var(--color-surface); }
  .about-portrait :global(img) { width: 100%; height: 100%; aspect-ratio: 1; object-fit: cover; }
  .about-lead { max-width: var(--measure); color: var(--color-neutral-700); }
  .developer-note { max-width: var(--measure); margin-top: 2rem; padding-left: 1.2rem; border-left: 3px solid var(--color-accent-2); color: var(--color-neutral-700); }
  .about-links { display: flex; gap: 1.25rem; margin-top: 2rem; }
  .about-links a { color: var(--color-text); font-weight: 650; text-underline-offset: .35rem; }
  @media (max-width: 42rem) { .about-layout { grid-template-columns: 1fr; } .about-portrait { max-width: 20rem; } }
</style>
