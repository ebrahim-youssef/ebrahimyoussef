---
// Hybrid square-Kufic "EY" monogram — blocky right-angled letterforms on a
// strict grid, framed in an octagon tile. Same geometry as
// assets/brand/monogram.svg, inlined so it can be sized/reused across the
// page without an extra request. Fixed light-theme colors on purpose: the
// site itself is light-only (see global.css `color-scheme: light`), unlike
// public/favicon.svg which swaps for dark browser chrome via prefers-color-scheme.
interface Props {
  size?: number;
  title?: string;
}
const { size = 40, title } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 64 64"
  xmlns="http://www.w3.org/2000/svg"
  role={title ? 'img' : undefined}
  aria-hidden={title ? undefined : 'true'}
>
  {title && <title>{title}</title>}
  <polygon
    fill="#faf6ef"
    stroke="#96431a"
    stroke-width="1.5"
    stroke-linejoin="round"
    points="6,2 58,2 62,6 62,58 58,62 6,62 2,58 2,6"
  />
  <g fill="#c05c21">
    <rect x="6" y="8" width="8" height="48"></rect>
    <rect x="6" y="8" width="24" height="8"></rect>
    <rect x="6" y="28" width="16" height="8"></rect>
    <rect x="6" y="48" width="24" height="8"></rect>
  </g>
  <g fill="#c05c21">
    <rect x="42" y="28" width="8" height="28"></rect>
    <rect x="36" y="20" width="8" height="8"></rect>
    <rect x="32" y="12" width="8" height="8"></rect>
    <rect x="48" y="20" width="8" height="8"></rect>
    <rect x="52" y="12" width="8" height="8"></rect>
  </g>
  <rect x="30" y="28" width="8" height="8" fill="#c4972f"></rect>
</svg>
