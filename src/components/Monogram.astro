---
import monogramUrl from '../../assets/brand/monogram.svg';

// The SVG asset is the sole source of mark geometry. The component references
// it instead of duplicating paths, while scripts/generate-icons.mjs derives the
// dark-background icon and social-card variants from the same file.
interface Props {
  size?: number;
  title?: string;
}
const { size = 40, title } = Astro.props;
// `size` is the rendered height in CSS pixels. The mark is wider than it is
// tall, so the width follows the asset's own viewBox rather than being squared
// off: the brand sheet forbids stretching, and a square box would letterbox it.
const MARK_ASPECT = 156 / 119;
const width = Math.round(size * MARK_ASPECT * 10) / 10;
---

<img src={monogramUrl.src} width={width} height={size} alt={title ?? ''} aria-hidden={title ? undefined : 'true'} />
