---
import { landing } from '../../data/landing';
import { type Locale } from '../../data/locale';

interface Props {
  locale: Locale;
}

const METHOD_GHOST: Record<Locale, string> = { en: 'طريقتي', ar: 'طريقتي' };
const { locale } = Astro.props;
const content = landing[locale];
---

<section class="chapter c-gold" id="method" aria-labelledby="method-title">
  <div class="ghost" aria-hidden="true" lang="ar">{METHOD_GHOST[locale]}</div>
  <div class="inner">
    <h2 id="method-title">{content.methodTitle}</h2>
    <ol class="steps">
      {content.steps.map((step) => (
        <li><b>{step.title}</b><span>{step.text}</span></li>
      ))}
    </ol>
  </div>
</section>
