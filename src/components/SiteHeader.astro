---
import { type Locale } from '../data/locale';
import { landing } from '../data/landing';
import { SITE_NAME, localizedPath } from '../data/siteMeta';
import Monogram from './Monogram.astro';

interface Props {
  locale: Locale;
  // Section links on pages other than the landing page point back to its anchors.
  sectionBase?: string;
  path?: string;
}

const { locale, sectionBase = '', path = '/' } = Astro.props;
const otherLocale: Locale = locale === 'en' ? 'ar' : 'en';
const content = landing[locale];
---

<header id="top" class="top">
  <a class="mark" href="#top" aria-label={SITE_NAME[locale]}>
    <Monogram size={40} />
  </a>
  <nav aria-label={content.navLabel}>
    {content.nav.map((item) => (
      <a href={`${sectionBase}#${item.id}`}>
        {item.label}
        {'ar' in item && item.ar && <span lang="ar" aria-hidden="true">{item.ar}</span>}
      </a>
    ))}
  </nav>
  <div class="side">
    <a
      class="lang"
      href={localizedPath(otherLocale, path)}
      lang={otherLocale}
      hreflang={otherLocale}
    >{content.switchLabel}</a>
  </div>
</header>

<style>
  .top { display: flex; justify-content: space-between; align-items: center; gap: 16px 28px; flex-wrap: wrap; background: var(--ground); padding: 40px 6vw 0; }
  .top .mark { background: var(--cream); padding: 6px 8px; display: flex; }
  .top .mark img { width: 40px; height: auto; display: block; }
  .top nav { display: flex; gap: 6px 22px; font-size: 15px; flex-wrap: wrap; flex: 1; justify-content: center; }
  .top nav a, .top .side a { text-decoration: none; display: grid; text-align: center; line-height: 1.25; padding-block: 4px; }
  .top nav a:hover, .top .side a:hover { text-decoration: underline; }
  .top nav a span, .top .side a span { font: 400 13px var(--kufi); color: var(--gold); }
  .top .side { display: flex; gap: 18px; align-items: center; font-size: 15px; }
  .top .side .lang { border: 1px solid #f7f1e855; padding: 6px 12px; }
  @media (max-width: 960px) {
    .top nav { order: 3; flex-basis: 100%; justify-content: flex-start; }
  }
  @media (max-width: 860px) {
    .top { padding: 28px 16px 0; }
    .top nav { gap: 18px; font-size: 14px; flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; margin-inline: -16px; padding-inline: 16px; mask-image: linear-gradient(to var(--fade-to, left), transparent, #000 24px); }
    [dir="rtl"] .top nav { --fade-to: right; }
    .top nav a { flex: none; }
  }
</style>
