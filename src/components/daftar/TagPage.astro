---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Monogram from '../Monogram.astro';
import { landing } from '../../data/landing';
import type { Locale } from '../../data/locale';
import { localizedPath } from '../../data/siteMeta';
import { postPath, slugify, type PostLike } from '../../lib/posts';
import '../../styles/daftar.css';

interface Props {
  locale: Locale;
  tag: string;
  posts: PostLike[];
  alternateTag?: string | null;
}

const { locale, tag, posts, alternateTag = null } = Astro.props;
const copy = locale === 'ar'
  ? { back: 'العودة إلى الدفتر', title: `كتابات عن «${tag}»`, language: 'اللغة', empty: 'لا توجد كتابات بهذا الوسم بعد.', daftar: 'دفتري' }
  : { back: 'Back to the daftar', title: `Writing about “${tag}”`, language: 'Language', empty: 'No writing has this tag yet.', daftar: 'My notebook' };
const dateFormatter = new Intl.DateTimeFormat(locale === 'ar' ? 'ar-EG' : 'en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
const path = `/daftar/tags/${slugify(tag)}/`;
---

<BaseLayout locale={locale} path={path} alternatePath={alternateTag ? `/daftar/tags/${slugify(alternateTag)}/` : null} title={copy.title} description={copy.title}>
  <header class="topbar">
    <a class="mark" href={localizedPath(locale, '/')} aria-label={landing[locale].title}>
      <Monogram size={40} />
      <span>{locale === 'ar' ? 'إبراهيم يوسف' : 'Ebrahim Youssef'}</span>
    </a>
    <nav aria-label={copy.daftar}>
      <a href={localizedPath(locale, '/daftar/')}>{copy.back}</a>
      <a class="lang" href={localizedPath(locale === 'en' ? 'ar' : 'en', alternateTag ? `/daftar/tags/${slugify(alternateTag)}/` : '/daftar/')} lang={locale === 'en' ? 'ar' : 'en'}>
        {locale === 'ar' ? 'English' : 'العربية'}
      </a>
    </nav>
  </header>

  <main id="main" class="post-page tag-page" aria-labelledby="tag-title">
    <section class="post-shell">
      <a class="post-back" href={localizedPath(locale, '/daftar/')}>{copy.back}</a>
      <h1 id="tag-title">{copy.title}</h1>
      {posts.length > 0 ? (
        <ul class="tag-posts">
          {posts.map((post) => (
            <li>
              <a href={postPath(locale, post.id)}>{post.data.title}</a>
              <span><time datetime={new Date(post.data.date).toISOString()}>{dateFormatter.format(new Date(post.data.date))}</time><span aria-hidden="true"> · </span>{post.data.lang === 'ar' ? 'العربية' : 'English'}</span>
            </li>
          ))}
        </ul>
      ) : <p>{copy.empty}</p>}
    </section>
  </main>
</BaseLayout>
