---
import { SITE } from '../data/site';
---

<section class="section section-contrast" id="audience" aria-labelledby="audience-title">
  <div class="wrap">
    <p class="eyebrow">Who this is for</p>
    <h2 id="audience-title" class="section-heading">Two kinds of people I build for.</h2>
    <ul role="list">
      {SITE.audiences.map((audience) => (
        <li class="card elev-sm">
          <h3>{audience.name}</h3>
          <p>{audience.body}</p>
          <a href={audience.cta.href}>{audience.cta.label}</a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  ul { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--leading); margin: 0; padding: 0; list-style: none; }
  li { padding: var(--leading); }
  h3 { margin: 0 0 var(--space-2); }
  li p { max-width: var(--measure); color: var(--color-neutral-700); }
  /* the card is a flex column, so an inline child would stretch the full width */
  li a { align-self: start; color: var(--color-text); font-weight: 650; text-underline-offset: .35rem; }
  @media (max-width: 44rem) { ul { grid-template-columns: 1fr; } }
</style>
