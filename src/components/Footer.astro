---
import { type Locale } from '../data/locale';
import { landing } from '../data/landing';
import { localizedPath } from '../data/siteMeta';

interface Props {
  locale: Locale;
  path?: string;
}

const { locale, path = '/' } = Astro.props;
const otherLocale: Locale = locale === 'en' ? 'ar' : 'en';
const content = landing[locale];
---

<footer>
  <span>{content.footer}</span>
  <a href={localizedPath(locale, '/daftar/')}>{content.daftarLink}</a>
  <a href={localizedPath(otherLocale, path)} lang={otherLocale} hreflang={otherLocale}>{content.switchLabel}</a>
</footer>

<style>
  footer { margin-top: 0; background: var(--ink); padding: 20px 6vw 40px; border-top: 1px solid #f7f1e833; display: flex; flex-wrap: wrap; gap: 10px 28px; font-size: 14px; color: #e7e2d4; }
  footer a { color: var(--gold); }
</style>
