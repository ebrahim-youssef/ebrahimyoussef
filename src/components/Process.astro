---
import Arabesque from './Arabesque.astro';
import { SITE } from '../data/site';
---

<section id="process" class="section" aria-labelledby="process-title">
  <div class="wrap">
    <p class="eyebrow">A clear path forward</p>
    <h2 id="process-title" class="section-heading process-title">How we get from idea to launch</h2>
    <ol class="process-list">
      {SITE.process.map((step, index) => (
        <li class="card elev-sm">
          <div class="step-marker">
            <Arabesque variant="mark" size={18} stroke="var(--color-accent)" />
            <span class="step-number">{String(index + 1).padStart(2, '0')}</span>
          </div>
          <h3>{step.name}</h3>
          <p>{step.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .process-title { max-width: 15ch; }
  .process-list { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--leading); margin: calc(2 * var(--leading)) 0 0; padding: 0; list-style: none; }
  li { padding: var(--leading); }
  .step-marker { display: flex; align-items: center; gap: var(--space-2); margin-bottom: var(--leading); }
  .step-number { color: var(--color-accent-700); font-size: 11px; font-weight: 600; letter-spacing: .1em; line-height: 1; text-transform: uppercase; }
  h3 { margin: 0 0 var(--space-2); }
  li p { max-width: var(--measure); margin: 0; color: var(--color-neutral-700); }
  @media (max-width: 48rem) { .process-list { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 28rem) { .process-list { grid-template-columns: 1fr; } }
</style>
